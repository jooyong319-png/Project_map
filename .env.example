# 콕콕콕 환경변수 — 실제 값은 .env.local (gitignore). Vercel 에도 같은 이름으로.
# VITE_ 접두사가 없으면 브라우저에 노출되지 않음(서버 함수 전용).

# ── 서버 함수 (Vercel) ──
KAKAO_REST_KEY=           # 카카오 로컬(장소·주소·주차장 검색, 길찾기). 결과는 실시간만 — 장소ID·place_url 외 저장 금지
NAVER_CLIENT_ID=          # 네이버 블로그 검색(상세 화면 실시간 후기 수만). 저장·AI 입력·광고 화면 금지
NAVER_CLIENT_SECRET=
GEMINI_API_KEY=           # AI 코스(없으면 휴리스틱 폴백)
GEMINI_MODEL=             # (선택) 기본 gemini-2.5-flash
ODSAY_API_KEY=            # (선택) 대중교통 이동시간

# ── 데이터 빌드 스크립트 전용 (scripts/buildArea·enrichArea·aiPick, 로컬에서만) ──
TOUR_API_KEY=             # data.go.kr 일반 인증키(Decoding) — TourAPI(15101578)·연관 관광지(15128560). 개발계정 하루 1,000건
# 원본 CSV 는 data_raw/ (gitignore): 일반·휴게음식점 인허가, 백년가게, 착한가격업소, 전국주차장정보표준데이터
